{
  "httpRequest": {
    "method": "POST",
    "path": "/jsonpath-date-time",
    "body": {
      "type": "JSON_PATH",
      "jsonPath": "$.order.created",
      "dateTime": {
        "after": "now -1 days",
        "actualFormat": "iso",
        "truncateExpected": "startOfDay",
        "zone": "Europe/London"
      }
    }
  },
  "httpResponse": {
    "body": "recent order"
  }
}
